# ==============================================================================
# VoxelRave Client - Environment Variables Example
# Copy this file to .env.local and fill in your actual values:
# cp .env.example .env.local
# ==============================================================================

# Backend Fastify / Socket.io Server URL
# Local development default: http://localhost:3001
# Production example: https://api.voxelrave.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Supabase Configuration (Singleplayer Leaderboard)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Service Role Key (Used strictly server-side in API routes for anti-cheat score submission)
# NEVER expose this key to client components or public repositories
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
