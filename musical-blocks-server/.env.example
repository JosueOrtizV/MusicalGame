# ==============================================================================
# VoxelRave Server - Environment Variables Example
# Copy this file to .env and adjust if needed:
# cp .env.example .env
# ==============================================================================

# Server HTTP and WebSocket Port
PORT=3001

# Node Environment ('development' or 'production')
NODE_ENV=development

# Pino Logger Level ('debug', 'info', 'warn', 'error')
LOG_LEVEL=info

# Allowed Frontend Client Origin for CORS and Socket.io Handshake
# Local: http://localhost:3000
# Production: https://voxelrave.com
CLIENT_ORIGIN=http://localhost:3000

# Optional: HMAC Secret for session tokens (defaults to cryptographically secure random bytes if omitted)
# HMAC_SECRET=your-32-byte-hex-secret
