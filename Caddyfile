# Production Caddyfile for VoxelRave Game Server

# Frontend Website
voxelrave.com {
    reverse_proxy client:3000
    
    # Enable compression
    encode zstd gzip
    
    # Basic Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' wss: ws: https:; worker-src 'self' blob:;"
        -Server
    }
}

# Backend API and WebSockets
api.voxelrave.com {
    # Proxy all traffic to the Node.js Fastify/Socket.io backend
    reverse_proxy server:3001 {
        # Enable WebSocket support
        header_up Upgrade {>Upgrade}
        header_up Connection {>Connection}
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Enable compression
    encode zstd gzip
    
    # Basic Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
